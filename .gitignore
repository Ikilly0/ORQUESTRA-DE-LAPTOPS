# entornos virtuales
.venv/
.venv312/
.venv-linux/
.venv-macos/
Keyboard Instruments.app/
__pycache__/
*.pyc
# datos personales de cada computador (se crean al usar la app)
profiles.json
settings.json
# logs y audios de prueba
*.log
*.wav
recordings/
!samples/*.wav
!T1-propuesta-de-obra/**/*.wav
build/
dist/
*.spec
# guitarra con amplificador: notas y gabinete propios, captura NAM GPL v3 (ver samples/guitarra_amp/LICENCIA-amp.txt)
!samples/guitarra_amp/*.wav
# cello continuo: solo las mediciones (parametros.npz); las notas de audio viejas ya no se usan
samples/cello/notas.*
# batería por secciones: audio real de la grabación, limpio (herramientas-audio/revision/limpiar_secciones.py)
!songs/*.secciones/*.wav
